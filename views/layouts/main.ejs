<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= title %> | Jeevadhara Wellness Center
  </title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Outfit:wght@300;400;500;600&display=swap"
    rel="stylesheet">
</head>

<body>

  <!-- Navigation -->
  <nav class="navbar">
    <div class="container nav-content">
      <a href="/" class="logo">Jeevadhara<span>.</span></a>
      
      <div class="nav-controls" style="display: flex; align-items: center; gap: 1rem;">
        <select id="langSelector" style="background: transparent; border: 1px solid var(--accent); color: var(--accent); padding: 0.3rem; border-radius: 8px; font-size: 0.8rem; cursor: pointer; font-family: var(--font-sans);">
          <option value="en">English</option>
          <option value="ta">தமிழ் (Tamil)</option>
          <option value="hi">हिन्दी (Hindi)</option>
        </select>
        
        <!-- Hamburger Icon -->
        <div class="hamburger" id="hamburger">
          <span></span>
          <span></span>
          <span></span>
        </div>
      </div>

      <ul class="nav-links" id="navLinks">
        <li><a href="/" data-i18n="nav_home" class="<%= currentPath === '/' ? 'active' : '' %>">Home</a></li>
        <li><a href="/about" data-i18n="nav_about" class="<%= currentPath === '/about' ? 'active' : '' %>">About</a></li>
        <li class="dropdown">
          <a href="/services" data-i18n="nav_services" class="<%= currentPath.startsWith('/services') ? 'active' : '' %>">Services ▾</a>
          <div class="dropdown-content">
            <a href="/services/online" data-i18n="nav_online" class="<%= currentPath === '/services/online' ? 'active' : '' %>">Online</a>
            <a href="/services/offline" data-i18n="nav_offline" class="<%= currentPath === '/services/offline' ? 'active' : '' %>">Offline</a>
          </div>
        </li>
        <li><a href="/blogs" data-i18n="nav_insights" class="<%= currentPath === '/blogs' ? 'active' : '' %>">Insights</a></li>
        <li><a href="/zen-zone" data-i18n="nav_zen_zone" class="<%= currentPath === '/zen-zone' ? 'active' : '' %>">Zen Zone</a></li>
        <li><a href="/contact" data-i18n="nav_contact" class="<%= currentPath === '/contact' ? 'active' : '' %>">Contact</a></li>

        <% if(user) { %>
          <% if(user.role === 'admin') { %>
            <li><a href="/admin" data-i18n="nav_admin" class="btn btn-outline nav-admin-btn <%= currentPath === '/admin' ? 'active' : '' %>">Admin Dashboard</a></li>
          <% } else { %>
            <li><a href="/dashboard" data-i18n="nav_dashboard" class="btn btn-outline <%= currentPath === '/dashboard' ? 'active' : '' %>">Dashboard</a></li>
          <% } %>
          <li><a href="/api/auth/logout" data-i18n="nav_logout" class="btn btn-primary">Logout</a></li>
          <% } else { %>
            <li><a href="/login" data-i18n="nav_login" class="btn btn-outline <%= currentPath === '/login' ? 'active' : '' %>">Login</a></li>
            <li><a href="/register" data-i18n="nav_signup" class="btn btn-primary nav-signup-btn <%= currentPath === '/register' ? 'active' : '' %>">Sign Up</a></li>
            <% } %>

      </ul>
    </div>
  </nav>

  <!-- Main Content Area where child views will be injected -->
  <main>
    <%- body %>
  </main>

  <!-- Floating WhatsApp Button -->
  <a href="https://wa.me/917010612322?text=Hi!%20I%20want%20to%20book%20a%20wellness%20service" target="_blank" class="whatsapp-btn">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="white">
      <path
        d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 1.763 6.279L.329 23.633l5.526-1.446A11.956 11.956 0 0 0 11.944 24 12 12 0 0 0 24 12 12 12 0 0 0 11.944 0zm0 22.02A9.973 9.973 0 0 1 6.848 20.6l-.367-.217-4.103 1.074 1.085-3.996-.237-.378A9.975 9.975 0 0 1 1.982 12 9.97 9.97 0 0 1 11.96 2.031a9.98 9.98 0 0 1 9.96 9.969 9.98 9.98 0 0 1-9.976 9.982zm5.474-7.468c-.3-.15-1.776-.877-2.05-.978-.275-.1-.475-.15-.675.15s-.775.978-.95 1.178-.35.225-.65.075-1.267-.467-2.416-1.49c-.894-.796-1.497-1.78-1.672-2.08-.175-.3-.018-.462.132-.612.135-.135.3-.35.45-.525.15-.175.2-.3.3-.5s.05-.375-.025-.525c-.075-.15-.675-1.625-.925-2.225-.24-.585-.487-.506-.675-.515-.175-.008-.375-.01-.575-.01s-.525.075-.8.375-1.05 1.025-1.05 2.5 1.075 2.895 1.225 3.095c.15.2 2.11 3.224 5.11 4.517 2.008.864 2.858 1.002 4.018.847 1.066-.143 3.045-1.246 3.47-2.45s.425-2.235.3-2.45c-.125-.215-.475-.34-.775-.49z" />
    </svg>
  </a>

  <!-- Footer -->
  <footer class="footer">
    <div class="container footer-content">
      <div class="footer-brand">
        <h2>Jeevadhara<span>.</span></h2>
        <p>Your peaceful escape in the heart of the city. Elevate your mind, body, and spirit with our holistic wellness
          programs.</p>
      </div>
      <div class="footer-links">
        <h3>Quick Links</h3>
        <ul>
          <li><a href="/about">About Us</a></li>
          <li><a href="/services">Services</a></li>
          <li><a href="/blogs">Wellness Insights</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>
      <div class="footer-newsletter" style="max-width: 300px;">
        <h3>Stay Nurtured</h3>
        <p style="font-size: 0.9rem; margin-bottom: 1.5rem; color: rgba(255,255,255,0.6);">Subscribe for weekly wellness tips.</p>
        <form onsubmit="handleNewsletter(event)" style="display: flex; gap: 0.5rem;">
          <input type="email" id="news-email" placeholder="Email" required style="padding: 0.7rem; border-radius: 8px; border: none; flex: 1; font-family: var(--font-sans);">
          <button type="submit" class="btn btn-primary" style="padding: 0.7rem 1rem; border-radius: 8px; background: var(--accent); white-space: nowrap;">Join</button>
        </form>
        <div id="news-msg" style="margin-top: 1rem; font-size: 0.8rem; display: none;"></div>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; 2026 Jeevadhara Wellness Center. All rights reserved.</p>
    </div>
  </footer>

  <script>
    const hamburger = document.getElementById('hamburger');
    const navLinks = document.getElementById('navLinks');

    if(hamburger) {
      hamburger.addEventListener('click', () => {
        hamburger.classList.toggle('active');
        navLinks.classList.toggle('show');
      });
    }

    async function handleNewsletter(e) {
      e.preventDefault();
      const email = document.getElementById('news-email').value;
      const msg = document.getElementById('news-msg');
      try {
        const res = await fetch('/api/newsletter', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email })
        });
        const data = await res.json();
        msg.textContent = data.message;
        msg.style.display = 'block';
        msg.style.color = data.success ? '#2ecc71' : '#e74c3c';
        if(data.success) document.getElementById('news-email').value = '';
      } catch(err) { console.error(err); }
    }



    // NEW Translation Dictionary
    const translations = {
      en: {
        nav_home: "Home", nav_about: "About", nav_services: "Services ▾", nav_online: "Online", nav_offline: "Offline",
        nav_insights: "Insights", nav_zen_zone: "Zen Zone", nav_contact: "Contact", 
        nav_admin: "Admin Dashboard", nav_dashboard: "Dashboard", nav_logout: "Logout", nav_login: "Login", nav_signup: "Sign Up",
        zen_hero_title: "The Zen Zone",
        zen_hero_desc: "Welcome to your sanctuary of stillness. Regulate your energy, restore your focus, and explore the wisdom of natural healing.",
        breath_title: "Regulate Your Breath",
        breath_guide: "Breathe in slowly as the sphere expands...",
        breath_pause: "Pause gently, feel the energy within...",
        breath_release: "Release and contract, let go of all tension...",
        breath_start: "Start Session",
        breath_stop: "Stop Session",
        breath_ready: "Ready?"
      },
      ta: {
        nav_home: "முகப்பு", nav_about: "எம்மைப் பற்றி", nav_services: "சேவைகள் ▾", nav_online: "ஆன்லைன்", nav_offline: "நேரடி",
        nav_insights: "நுண்ணறிவு", nav_zen_zone: "ஜென் மண்டலம்", nav_contact: "தொடர்பு", 
        nav_admin: "நிர்வாகி", nav_dashboard: "டாஷ்போர்டு", nav_logout: "வெளியேறு", nav_login: "உள்நுழை", nav_signup: "பதிவு",
        zen_hero_title: "ஜென் மண்டலம்",
        zen_hero_desc: "உங்கள் அமைதியின் புகலிடத்திற்கு வரவேற்கிறோம். உங்கள் ஆற்றலை ஒழுங்குபடுத்தி, உங்கள் கவனத்தை மீட்டெடுத்து, இயற்கையான குணப்படுத்துதலின் ஞானத்தை ஆராயுங்கள்.",
        breath_title: "உங்கள் சுவாசத்தை ஒழுங்குபடுத்துங்கள்",
        breath_guide: "சுவாசம் எடுக்கும்போது கோளம் விரிவடையும்...",
        breath_pause: "மெதுவாக இடைநிறுத்தி, உள்ளிருக்கும் ஆற்றலை உணருங்கள்...",
        breath_release: "சுவாசத்தை விடுத்து, அனைத்து அழுத்தங்களையும் விடுங்கள்...",
        breath_start: "தொடங்கு",
        breath_stop: "நிறுத்து",
        breath_ready: "தயாரா?"
      },
      hi: {
        nav_home: "होम", nav_about: "हमारे बारे में", nav_services: "सेवाएं ▾", nav_online: "ऑनलाइन", nav_offline: "ऑफ़लाइन",
        nav_insights: "अंतर्दृष्टि", nav_zen_zone: "ज़ेन ज़ोन", nav_contact: "संपर्क", 
        nav_admin: "एडमिन डैशबोर्ड", nav_dashboard: "डैशबोर्ड", nav_logout: "लॉगआउट", nav_login: "लॉगिन", nav_signup: "साइन अप",
        zen_hero_title: "ज़ेन ज़ोन",
        zen_hero_desc: "स्थिरता के आपके अभयारण्य में आपका स्वागत है। अपनी ऊर्जा को विनियमित करें, अपना ध्यान बहाल करें, और प्राकृतिक चिकित्सा के ज्ञान का पता लगाएं।",
        breath_title: "अपनी सांस को नियंत्रित करें",
        breath_guide: "गोला फैलने पर धीरे-धीरे सांस लें...",
        breath_pause: "धीरे से रुकें, भीतर की ऊर्जा को महसूस करें...",
        breath_release: "सांस छोड़ें और सभी तनाव को दूर होने दें...",
        breath_start: "सत्र शुरू करें",
        breath_stop: "सत्र रोकें",
        breath_ready: "तैयार?"
      }
    };

    function applyTranslations(lang) {
      const t = translations[lang];
      if(!t) return;
      
      // Target elements with data-i18n attribute
      const elements = document.querySelectorAll('[data-i18n]');
      elements.forEach(el => {
        const key = el.getAttribute('data-i18n');
        if (t[key]) {
          // If it's an input or button, we might want to change value/placeholder, 
          // but for this app content is mostly textContent.
          el.textContent = t[key];
        }
      });
    }

    if(langSelector) {
      langSelector.addEventListener('change', (e) => {
        const lang = e.target.value;
        localStorage.setItem('lang', lang);
        applyTranslations(lang);
      });

      const savedLang = localStorage.getItem('lang');
      if (savedLang) {
        langSelector.value = savedLang;
        // Immediate apply after tiny delay to ensure page elements are ready
        setTimeout(() => applyTranslations(savedLang), 50);
      }
    }



    /* Zen Hub Styles */
    #zen-hub-trigger {
      position: fixed;
      bottom: 30px;
      right: 30px;
      width: 60px;
      height: 60px;
      background: linear-gradient(135deg, #166534 0%, #064e3b 100%);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      box-shadow: 0 10px 25px rgba(0,0,0,0.2);
      cursor: pointer;
      z-index: 9999;
      transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      border: 2px solid rgba(255,255,255,0.1);
    }
    #zen-hub-trigger:hover {
      transform: scale(1.1) rotate(15deg);
      box-shadow: 0 15px 35px rgba(16, 185, 129, 0.4);
    }
    #zen-hub-panel {
      position: fixed;
      bottom: 100px;
      right: 30px;
      width: 320px;
      background: rgba(255, 255, 255, 0.7);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-radius: 24px;
      box-shadow: 0 20px 50px rgba(0,0,0,0.1);
      border: 1px solid rgba(255,255,255,0.4);
      z-index: 9998;
      padding: 2rem;
      transform: translateY(20px) scale(0.95);
      opacity: 0;
      visibility: hidden;
      transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    }
    #zen-hub-panel.active {
      transform: translateY(0) scale(1);
      opacity: 1;
      visibility: visible;
    }
    .hub-title {
      font-family: var(--font-serif);
      color: var(--primary-dark);
      margin-bottom: 0.5rem;
      font-size: 1.25rem;
    }
    .hub-quote {
      font-style: italic;
      color: var(--text-light);
      font-size: 0.9rem;
      line-height: 1.6;
      margin-bottom: 1.5rem;
    }
    .hub-link {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 0.8rem 1rem;
      background: rgba(255,255,255,0.5);
      border-radius: 12px;
      color: var(--primary);
      text-decoration: none;
      font-weight: 600;
      font-size: 0.85rem;
      margin-bottom: 0.8rem;
      transition: all 0.2s;
    }
    .hub-link:hover {
      background: white;
      transform: translateX(5px);
      box-shadow: var(--shadow-sm);
    }
  </style>

  <!-- Zen Hub Floating Assistant -->
  <div id="zen-hub-panel">
    <h3 class="hub-title">Zen Assistant</h3>
    <p class="hub-quote" id="zen-quote">"True healing begins when the mind finds stillness."</p>
    
    <a href="/dashboard" class="hub-link">
      <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
      View My Journey
    </a>
    <a href="/zen-zone" class="hub-link">
      <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
      Breathing Focus
    </a>
  </div>

  <div id="zen-hub-trigger" title="Zen Assistant">
    <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
  </div>

  <script>
    // Zen Hub Logic
    const hubTrigger = document.getElementById('zen-hub-trigger');
    const hubPanel = document.getElementById('zen-hub-panel');
    const zenQuote = document.getElementById('zen-quote');

    const quotes = [
      "True healing begins when the mind finds stillness.",
      "Nature does not hurry, yet everything is accomplished.",
      "Your heart is the best physician.",
      "In every walk with nature, one receives more than he seeks.",
      "Wellness is a primary connection with the self."
    ];

    hubTrigger.addEventListener('click', () => {
      hubPanel.classList.toggle('active');
      if (hubPanel.classList.contains('active')) {
        zenQuote.textContent = `"${quotes[Math.floor(Math.random() * quotes.length)]}"`;
      }
    });

    // Close on click outside
    document.addEventListener('click', (e) => {
      if (!hubPanel.contains(e.target) && !hubTrigger.contains(e.target)) {
        hubPanel.classList.remove('active');
      }
    });

</body>
</html>