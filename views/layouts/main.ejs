<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= title %> | Jeevadhara Wellness Center
  </title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Outfit:wght@300;400;500;600&display=swap"
    rel="stylesheet">
</head>

<body>

  <!-- Navigation -->
  <nav class="navbar">
    <div class="container nav-content">
      <a href="/" class="logo">Jeevadhara<span>.</span></a>
      
      <div style="display: flex; align-items: center; gap: 1rem;">
        <select id="langSelector" style="background: transparent; border: 1px solid var(--accent); color: var(--accent); padding: 0.3rem; border-radius: 8px; font-size: 0.8rem; cursor: pointer; font-family: var(--font-sans);">
          <option value="en">English</option>
          <option value="ta">தமிழ் (Tamil)</option>
          <option value="hi">हिन्दी (Hindi)</option>
        </select>
      </div>
      
      <!-- Hamburger Icon -->
      <div class="hamburger" id="hamburger">
        <span></span>
        <span></span>
        <span></span>
      </div>

      <ul class="nav-links" id="navLinks">
        <li><a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">Home</a></li>
        <li><a href="/about" class="<%= currentPath === '/about' ? 'active' : '' %>">About</a></li>
        <li class="dropdown">
          <a href="/services" class="<%= currentPath.startsWith('/services') ? 'active' : '' %>">Services ▾</a>
          <div class="dropdown-content">
            <a href="/services/online" class="<%= currentPath === '/services/online' ? 'active' : '' %>">Online</a>
            <a href="/services/offline" class="<%= currentPath === '/services/offline' ? 'active' : '' %>">Offline</a>
          </div>
        </li>
        <li><a href="/blogs" class="<%= currentPath === '/blogs' ? 'active' : '' %>">Insights</a></li>
        <li><a href="/advisor" class="<%= currentPath === '/advisor' ? 'active' : '' %>">AI Advisor</a></li>
        <li><a href="/contact" class="<%= currentPath === '/contact' ? 'active' : '' %>">Contact</a></li>

        <% if(user) { %>
          <% if(user.role === 'admin') { %>
            <li><a href="/admin" class="btn btn-outline nav-admin-btn <%= currentPath === '/admin' ? 'active' : '' %>">Admin Dashboard</a></li>
          <% } else { %>
            <li><a href="/dashboard" class="btn btn-outline <%= currentPath === '/dashboard' ? 'active' : '' %>">Dashboard</a></li>
          <% } %>
          <li><a href="/api/auth/logout" class="btn btn-primary">Logout</a></li>
          <% } else { %>
            <li><a href="/login" class="btn btn-outline <%= currentPath === '/login' ? 'active' : '' %>">Login</a></li>
            <li><a href="/register" class="btn btn-primary nav-signup-btn <%= currentPath === '/register' ? 'active' : '' %>">Sign Up</a></li>
            <% } %>
        <li>
          <button id="zenToggle" style="background: none; border: 1px solid var(--accent); color: var(--accent); padding: 0.4rem 0.8rem; border-radius: 20px; cursor: pointer; font-size: 0.8rem; font-weight: 600; transition: var(--transition);">
            ZEN MODE
          </button>
        </li>
      </ul>
    </div>
  </nav>

  <!-- Main Content Area where child views will be injected -->
  <main>
    <%- body %>
  </main>

  <!-- Floating WhatsApp Button -->
  <a href="https://wa.me/917010612322?text=Hi!%20I%20want%20to%20book%20a%20wellness%20service" target="_blank" class="whatsapp-btn">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="white">
      <path
        d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 1.763 6.279L.329 23.633l5.526-1.446A11.956 11.956 0 0 0 11.944 24 12 12 0 0 0 24 12 12 12 0 0 0 11.944 0zm0 22.02A9.973 9.973 0 0 1 6.848 20.6l-.367-.217-4.103 1.074 1.085-3.996-.237-.378A9.975 9.975 0 0 1 1.982 12 9.97 9.97 0 0 1 11.96 2.031a9.98 9.98 0 0 1 9.96 9.969 9.98 9.98 0 0 1-9.976 9.982zm5.474-7.468c-.3-.15-1.776-.877-2.05-.978-.275-.1-.475-.15-.675.15s-.775.978-.95 1.178-.35.225-.65.075-1.267-.467-2.416-1.49c-.894-.796-1.497-1.78-1.672-2.08-.175-.3-.018-.462.132-.612.135-.135.3-.35.45-.525.15-.175.2-.3.3-.5s.05-.375-.025-.525c-.075-.15-.675-1.625-.925-2.225-.24-.585-.487-.506-.675-.515-.175-.008-.375-.01-.575-.01s-.525.075-.8.375-1.05 1.025-1.05 2.5 1.075 2.895 1.225 3.095c.15.2 2.11 3.224 5.11 4.517 2.008.864 2.858 1.002 4.018.847 1.066-.143 3.045-1.246 3.47-2.45s.425-2.235.3-2.45c-.125-.215-.475-.34-.775-.49z" />
    </svg>
  </a>

  <!-- Footer -->
  <footer class="footer">
    <div class="container footer-content">
      <div class="footer-brand">
        <h2>Jeevadhara<span>.</span></h2>
        <p>Your peaceful escape in the heart of the city. Elevate your mind, body, and spirit with our holistic wellness
          programs.</p>
      </div>
      <div class="footer-links">
        <h3>Quick Links</h3>
        <ul>
          <li><a href="/about">About Us</a></li>
          <li><a href="/services">Services</a></li>
          <li><a href="/blogs">Wellness Insights</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>
      <div class="footer-newsletter" style="max-width: 300px;">
        <h3>Stay Nurtured</h3>
        <p style="font-size: 0.9rem; margin-bottom: 1.5rem; color: rgba(255,255,255,0.6);">Subscribe for weekly wellness tips.</p>
        <form onsubmit="handleNewsletter(event)" style="display: flex; gap: 0.5rem;">
          <input type="email" id="news-email" placeholder="Email" required style="padding: 0.7rem; border-radius: 8px; border: none; flex: 1; font-family: var(--font-sans);">
          <button type="submit" class="btn btn-primary" style="padding: 0.7rem 1rem; border-radius: 8px; background: var(--accent); white-space: nowrap;">Join</button>
        </form>
        <div id="news-msg" style="margin-top: 1rem; font-size: 0.8rem; display: none;"></div>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; 2026 Jeevadhara Wellness Center. All rights reserved.</p>
    </div>
  </footer>

  <script>
    const hamburger = document.getElementById('hamburger');
    const navLinks = document.getElementById('navLinks');

    if(hamburger) {
      hamburger.addEventListener('click', () => {
        hamburger.classList.toggle('active');
        navLinks.classList.toggle('show');
      });
    }

    async function handleNewsletter(e) {
      e.preventDefault();
      const email = document.getElementById('news-email').value;
      const msg = document.getElementById('news-msg');
      try {
        const res = await fetch('/api/newsletter', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email })
        });
        const data = await res.json();
        msg.textContent = data.message;
        msg.style.display = 'block';
        msg.style.color = data.success ? '#2ecc71' : '#e74c3c';
        if(data.success) document.getElementById('news-email').value = '';
      } catch(err) { console.error(err); }
    }

    // Zen Mode Toggle Logic
    const zenToggle = document.getElementById('zenToggle');
    const currentTheme = localStorage.getItem('theme');

    if (currentTheme) {
      document.documentElement.setAttribute('data-theme', currentTheme);
      if (currentTheme === 'dark') zenToggle.textContent = 'SOLAR MODE';
    }

    zenToggle.addEventListener('click', () => {
      let theme = document.documentElement.getAttribute('data-theme');
      if (theme === 'dark') {
        document.documentElement.removeAttribute('data-theme');
        localStorage.setItem('theme', 'light');
        zenToggle.textContent = 'ZEN MODE';
      } else {
        document.documentElement.setAttribute('data-theme', 'dark');
        localStorage.setItem('theme', 'dark');
        zenToggle.textContent = 'SOLAR MODE';
      }
    });

    // Language Translation Logic
    const langSelector = document.getElementById('langSelector');
    const translations = {
      en: {
        home: "Home", about: "About", services: "Services ▾", contact: "Contact", 
        login: "Login", signup: "Sign Up", logout: "Logout", dashboard: "Dashboard",
        zen: "ZEN MODE", solar: "SOLAR MODE"
      },
      ta: {
        home: "முகப்பு", about: "எம்மைப் பற்றி", services: "சேவைகள் ▾", contact: "தொடர்பு", 
        login: "உள்நுழை", signup: "பதிவு", logout: "வெளியேறு", dashboard: "டாஷ்போர்டு",
        zen: "ஜென் நிலை", solar: "ஒளி நிலை"
      },
      hi: {
        home: "होम", about: "हमारे बारे में", services: "सेवाएं ▾", contact: "संपर्क", 
        login: "लॉगिन", signup: "साइन अप", logout: "लॉगआउट", dashboard: "डैशबोर्ड",
        zen: "ज़ेन मोड", solar: "सौर मोड"
      }
    };

    function applyTranslations(lang) {
      const t = translations[lang];
      if(!t) return;
      const links = document.querySelectorAll('#navLinks a');
      links.forEach(link => {
        const text = link.textContent.trim().toLowerCase();
        if (text.includes('home')) link.textContent = t.home;
        if (text.includes('about')) link.textContent = t.about;
        if (text.includes('services')) link.textContent = t.services;
        if (text.includes('contact')) link.textContent = t.contact;
        if (text.includes('login')) link.textContent = t.login;
        if (text.includes('sign up')) link.textContent = t.signup;
        if (text.includes('logout')) link.textContent = t.logout;
        if (text.includes('dashboard')) link.textContent = t.dashboard;
      });
      const zenBtn = document.getElementById('zenToggle');
      if(zenBtn) {
        zenBtn.textContent = (document.documentElement.getAttribute('data-theme') === 'dark') ? t.solar : t.zen;
      }
    }

    if(langSelector) {
      langSelector.addEventListener('change', (e) => {
        const lang = e.target.value;
        localStorage.setItem('lang', lang);
        applyTranslations(lang);
      });

      const savedLang = localStorage.getItem('lang');
      if (savedLang) {
        langSelector.value = savedLang;
        setTimeout(() => applyTranslations(savedLang), 100);
      }
    }

  </script>
</body>
</html>