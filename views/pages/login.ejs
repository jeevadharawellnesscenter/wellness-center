<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>

<div class="auth-wrapper">
  <div class="auth-card" style="padding-top: 1.5rem;">
    <!-- Three.js Canvas Container for Character Animation -->
    <div id="three-container" style="width: 100%; height: 160px; margin-bottom: 1.5rem; border-radius: 8px; overflow: hidden; background: #e0f2fe; display: flex; justify-content: center; align-items: center; position: relative;">
      <!-- Canvas will be injected here -->
    </div>

    <h2>Welcome Back</h2>
    <form id="loginForm">
      <div class="form-group">
        <label for="email">Email Address</label>
        <input type="email" id="email" class="form-control" required placeholder="Enter your email">
      </div>
      <div class="form-group">
        <label for="password">Password</label>
        <input type="password" id="password" class="form-control" required placeholder="Enter your password">
      </div>
      <div id="error-msg" class="form-error"></div>
      <button type="submit" class="btn btn-primary">Log In</button>
    </form>
    
    <div class="auth-switch" style="margin-top: 1rem; border-bottom: 1px solid #eee; padding-bottom: 1rem;">
      Forgot your password? <a href="/forgot-password">Reset it here</a>
    </div>
    <div class="auth-switch" style="margin-top: 1rem;">
      Don't have an account? <a href="/register">Sign Up</a>
    </div>
  </div>
</div>

<script>
  // --- THREE.JS ANIMATION CODE ---
  const container = document.getElementById('three-container');
  const width = container.clientWidth;
  const height = container.clientHeight;

  const scene = new THREE.Scene();
  // Ensure transparent background (or match container #e0f2fe)
  scene.background = new THREE.Color(0xe0f2fe);

  const camera = new THREE.PerspectiveCamera(50, width / height, 0.1, 1000);
  camera.position.z = 5;
  camera.position.y = 0.5;

  const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
  renderer.setSize(width, height);
  container.appendChild(renderer.domElement);

  // Lighting
  const ambientLight = new THREE.AmbientLight(0xffffff, 0.6);
  scene.add(ambientLight);
  const dirLight = new THREE.DirectionalLight(0xffffff, 0.6);
  dirLight.position.set(2, 5, 3);
  scene.add(dirLight);

  // Character Group
  const character = new THREE.Group();
  scene.add(character);

  // Head
  const headGeo = new THREE.BoxGeometry(2, 2, 2);
  const matYel = new THREE.MeshLambertMaterial({ color: 0xffcc44 }); // yellow cute color
  const head = new THREE.Mesh(headGeo, matYel);
  character.add(head);

  // Eyes
  const eyeGeo = new THREE.CircleGeometry(0.2, 32);
  const matBlack = new THREE.MeshBasicMaterial({ color: 0x222222 });
  
  const leftEye = new THREE.Mesh(eyeGeo, matBlack);
  leftEye.position.set(-0.5, 0.2, 1.01);
  character.add(leftEye);

  const rightEye = new THREE.Mesh(eyeGeo, matBlack);
  rightEye.position.set(0.5, 0.2, 1.01);
  character.add(rightEye);

  // Mouth
  const mouthGeo = new THREE.BoxGeometry(0.6, 0.2, 0.1);
  const mouth = new THREE.Mesh(mouthGeo, matBlack);
  mouth.position.set(0, -0.4, 1.01);
  character.add(mouth);

  // Hands (to cover eyes)
  const handGeo = new THREE.BoxGeometry(0.6, 0.6, 0.6);
  // Left Hand
  const leftHand = new THREE.Mesh(handGeo, matYel);
  leftHand.position.set(-1.2, -1, 1.2);
  character.add(leftHand);

  // Right Hand
  const rightHand = new THREE.Mesh(handGeo, matYel);
  rightHand.position.set(1.2, -1, 1.2);
  character.add(rightHand);

  // Animation variables
  let eyesCovered = false;
  let headRotationTarget = { x: 0, y: 0 };

  // Targets for hands
  // Uncovered:
  const L_HAND_REST = { x: -1.2, y: -1, z: 1.2 };
  const R_HAND_REST = { x: 1.2, y: -1, z: 1.2 };
  // Covered:
  const L_HAND_COVER = { x: -0.5, y: 0.2, z: 1.3 };
  const R_HAND_COVER = { x: 0.5, y: 0.2, z: 1.3 };

  // Render loop
  function animate() {
    requestAnimationFrame(animate);

    // Smooth head rotation tracking mouse/input
    character.rotation.x += (headRotationTarget.x - character.rotation.x) * 0.1;
    character.rotation.y += (headRotationTarget.y - character.rotation.y) * 0.1;

    // Smooth hand movement
    const targetL = eyesCovered ? L_HAND_COVER : L_HAND_REST;
    const targetR = eyesCovered ? R_HAND_COVER : R_HAND_REST;

    leftHand.position.lerp(new THREE.Vector3(targetL.x, targetL.y, targetL.z), 0.15);
    rightHand.position.lerp(new THREE.Vector3(targetR.x, targetR.y, targetR.z), 0.15);

    renderer.render(scene, camera);
  }
  animate();

  // Handle Resize
  window.addEventListener('resize', () => {
    const newWidth = container.clientWidth;
    const newHeight = container.clientHeight;
    renderer.setSize(newWidth, newHeight);
    camera.aspect = newWidth / newHeight;
    camera.updateProjectionMatrix();
  });

  // --- FORM INTERACTIONS ---
  const emailInput = document.getElementById('email');
  const passwordInput = document.getElementById('password');

  // Look around when typing email
  emailInput.addEventListener('input', (e) => {
    // Estimate typing progress to move head slightly
    const val = e.target.value.length;
    headRotationTarget.y = (val % 10 - 5) * 0.05; 
  });
  emailInput.addEventListener('focus', () => {
    eyesCovered = false;
    headRotationTarget.x = 0.2; // look slightly down
  });
  emailInput.addEventListener('blur', () => {
    headRotationTarget.x = 0;
    headRotationTarget.y = 0;
  });

  // Cover eyes on password focus
  passwordInput.addEventListener('focus', () => {
    eyesCovered = true;
    headRotationTarget.x = 0.1;
    headRotationTarget.y = 0;
  });
  passwordInput.addEventListener('blur', () => {
    eyesCovered = false;
    headRotationTarget.x = 0;
  });


  // --- LOGIN LOGIC ---
  document.getElementById('loginForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = emailInput.value;
    const password = passwordInput.value;

    try {
      const res = await fetch('/api/auth/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, password })
      });
      const data = await res.json();

      if (data.success) {
        window.location.href = '/dashboard';
      } else {
        const err = document.getElementById('error-msg');
        err.style.display = 'block';
        err.textContent = data.message || 'Login failed';
      }
    } catch (err) {
      console.log(err);
    }
  });
</script>