<section class="page-hero" style="background: linear-gradient(135deg, #123524 0%, #0A1C13 100%); min-height: 40vh; display: flex; align-items: center; justify-content: center; text-align: center; color: white; position: relative; overflow: hidden;">
  <div class="container" style="z-index: 2;">
    <h1 style="color: white; font-size: clamp(2.5rem, 8vw, 4rem); margin-bottom: 1rem;">AI Wellness Advisor</h1>
    <p style="color: rgba(255,255,255,0.8); font-size: 1.2rem; max-width: 600px; margin: 0 auto;">Speak with our peaceful AI guide to discover the perfect naturopathy path for your needs.</p>
  </div>
  <!-- Abstract decorations -->
  <div style="position: absolute; top: -10%; right: -10%; width: 400px; height: 400px; background: radial-gradient(circle, rgba(207,157,64,0.1) 0%, transparent 70%); border-radius: 50%;"></div>
</section>

<section class="section" style="background: var(--bg-light);">
  <div class="container" style="max-width: 800px;">
    <div id="chat-container" style="background: white; border-radius: 30px; box-shadow: var(--shadow-lg); overflow: hidden; display: flex; flex-direction: column; height: 600px; border: 1px solid rgba(0,0,0,0.03);">
      
      <!-- Chat Header -->
      <div style="padding: 1.5rem 2rem; background: var(--primary); color: white; display: flex; align-items: center; gap: 1rem;">
        <div style="width: 12px; height: 12px; background: #2ecc71; border-radius: 50%; box-shadow: 0 0 10px #2ecc71;"></div>
        <span style="font-weight: 600; letter-spacing: 1px;">JEEVADHARA ADVISOR</span>
      </div>

      <!-- Messages Area -->
      <div id="message-area" style="flex: 1; padding: 2rem; overflow-y: auto; display: flex; flex-direction: column; gap: 1.5rem;">
        <div style="align-self: flex-start; background: #f0f7f4; padding: 1.2rem 1.5rem; border-radius: 20px 20px 20px 5px; max-width: 80%; line-height: 1.6; color: var(--text-dark); box-shadow: var(--shadow-sm);">
          Greetings. I am here to assist you on your journey to holistic health. What is your health goal today? 🌿
        </div>
      </div>

      <!-- Quick Goals -->
      <div style="padding: 1rem 2rem; display: flex; gap: 0.5rem; flex-wrap: wrap; background: #fafafa; border-top: 1px solid #eee;">
        <button onclick="setGoal('Stress Relief')" class="btn" style="padding: 0.4rem 1rem; font-size: 0.8rem; background: white; border: 1px solid var(--accent); color: var(--accent);">Stress Relief</button>
        <button onclick="setGoal('Detoxification')" class="btn" style="padding: 0.4rem 1rem; font-size: 0.8rem; background: white; border: 1px solid var(--accent); color: var(--accent);">Detoxification</button>
        <button onclick="setGoal('Better Sleep')" class="btn" style="padding: 0.4rem 1rem; font-size: 0.8rem; background: white; border: 1px solid var(--accent); color: var(--accent);">Better Sleep</button>
      </div>

      <!-- Input Area -->
      <form onsubmit="handleChatSubmit(event)" style="padding: 1.5rem 2rem; display: flex; gap: 1rem; background: white; border-top: 1px solid #eee;">
        <input type="text" id="chat-input" placeholder="Describe how you're feeling..." required style="flex: 1; padding: 1rem 1.5rem; border-radius: 15px; border: 1px solid #ddd; font-family: var(--font-sans); font-size: 1rem; outline: none; transition: var(--transition);">
        <button type="submit" id="send-btn" class="btn btn-primary" style="padding: 1rem 2rem; border-radius: 15px;">Send</button>
      </form>
    </div>
  </div>
</section>

<script>
  let currentGoal = '';

  function setGoal(goal) {
    currentGoal = goal;
    document.getElementById('chat-input').value = `I am looking for help with ${goal}.`;
  }

  function appendMessage(text, isUser = false) {
    const area = document.getElementById('message-area');
    const msg = document.createElement('div');
    msg.style.alignSelf = isUser ? 'flex-end' : 'flex-start';
    msg.style.background = isUser ? 'var(--primary)' : '#f0f7f4';
    msg.style.color = isUser ? 'white' : 'var(--text-dark)';
    msg.style.padding = '1.2rem 1.5rem';
    msg.style.borderRadius = isUser ? '20px 20px 5px 20px' : '20px 20px 20px 5px';
    msg.style.maxWidth = '80%';
    msg.style.lineHeight = '1.6';
    msg.style.boxShadow = 'var(--shadow-sm)';
    msg.textContent = text;
    area.appendChild(msg);
    area.scrollTop = area.scrollHeight;
  }

  async function handleChatSubmit(e) {
    e.preventDefault();
    const input = document.getElementById('chat-input');
    const btn = document.getElementById('send-btn');
    const message = input.value.trim();
    if (!message) return;

    appendMessage(message, true);
    input.value = '';
    btn.disabled = true;
    btn.textContent = '...';

    try {
      const res = await fetch('/api/ai/advise', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ message, healthGoal: currentGoal })
      });
      const data = await res.json();
      if (data.success) {
        appendMessage(data.advice);
      } else {
        appendMessage("Advisor Note: " + (data.message || "I'm having trouble connecting right now. Please try again later."));
      }
    } catch (err) {
      console.error(err);
      appendMessage("Something went wrong. Please check your connection.");
    } finally {
      btn.disabled = false;
      btn.textContent = 'Send';
    }
  }
</script>
