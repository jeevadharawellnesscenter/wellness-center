<div class="auth-wrapper" style="min-height: 60vh;">
  <div class="auth-card" style="text-align: center; max-width: 500px;">
    <div style="font-size: 4rem; color: #e74c3c; margin-bottom: 1rem;">❌</div>
    <h2 style="color: #e74c3c;">Payment Cancelled</h2>
    <p style="margin-top: 1.5rem; color: var(--text-light); font-size: 1.1rem;">
      <%= typeof message !=='undefined' ? message : 'The transaction was cancelled and no charges were made.' %>
    </p>
    <a href="/dashboard" class="btn btn-primary" style="margin-top: 2rem; display: inline-block;">Return to
      Dashboard</a>
  </div>
</div>