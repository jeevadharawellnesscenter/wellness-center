<!-- Load Three.js -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>

<div class="page-breadcrumb">
  <div class="container">
    <a href="/">Home</a> &gt; <span style="color: var(--primary); font-weight: 500;">Contact</span>
  </div>
</div>

<section class="section" style="min-height: 80vh; display: flex; align-items: center; background: linear-gradient(135deg, #f8faf8, #e0f2eb); padding: 4rem 0;">
  <div class="container">
    
    <div style="text-align: center; margin-bottom: 3rem;">
      <h1 style="font-size: 3.5rem; color: var(--primary-dark); text-shadow: 0 4px 10px rgba(0,0,0,0.05); margin-bottom: 0.5rem;">Let's Connect</h1>
      <p style="color: var(--text-light); font-size: 1.2rem; max-width: 600px; margin: 0 auto;">We are here to answer your questions and guide you on your wellness journey.</p>
    </div>

    <!-- Contact Grid Wrapper -->
    <div style="display: flex; flex-wrap: wrap; background: white; border-radius: 20px; box-shadow: 0 25px 50px rgba(0,0,0,0.06); overflow: hidden;">
      
      <!-- 3D Canvas Column -->
      <div id="contact-three-canvas" style="flex: 1 1 50%; min-height: 500px; background: linear-gradient(135deg, #102a1d, #205c3d); position: relative; overflow: hidden; display: flex; align-items: center; justify-content: center;">
        
        <div style="position: absolute; top: 2.5rem; left: 2.5rem; color: white; z-index: 5;">
          <h3 style="font-size: 2.2rem; margin-bottom: 0.5rem; text-shadow: 0 2px 5px rgba(0,0,0,0.5);">Telephonic Support</h3>
          <p style="color: rgba(255,255,255,0.85); font-size: 1.1rem; line-height: 1.5; max-width: 250px;">Whenever you need guidance, our experts are just a ring away.</p>
        </div>

        <div style="position: absolute; bottom: 2rem; left: 2.5rem; color: white; z-index: 5; font-size: 1.1rem;">
          <p style="margin-bottom: 0.5rem;">📞 +91 99407 16032</p>
          <p>✉️ support@jeevadhara.com</p>
        </div>

      </div>

      <!-- Form Column -->
      <div style="flex: 1 1 50%; padding: 4rem 3rem; display: flex; flex-direction: column; justify-content: center;">
        <h3 style="margin-bottom: 2rem; font-size: 2rem; color: var(--text-dark);">Send a Message</h3>
        <form id="contactForm">
          <div class="form-group" style="margin-bottom: 1.5rem;">
            <label style="font-weight: 600; color: var(--text-dark); margin-bottom: 0.5rem; display: block;">Full Name</label>
            <input type="text" id="contactName" class="form-control" placeholder="John Doe" style="padding: 1rem; border-radius: 10px; border: 1px solid #ddd; width: 100%; box-shadow: var(--shadow-sm); transition: border 0.3s;" onfocus="this.style.borderColor='var(--primary)'" onblur="this.style.borderColor='#ddd'" required>
          </div>
          <div class="form-group" style="margin-bottom: 1.5rem;">
            <label style="font-weight: 600; color: var(--text-dark); margin-bottom: 0.5rem; display: block;">Email Address</label>
            <input type="email" id="contactEmail" class="form-control" placeholder="john@example.com" style="padding: 1rem; border-radius: 10px; border: 1px solid #ddd; width: 100%; box-shadow: var(--shadow-sm); transition: border 0.3s;" onfocus="this.style.borderColor='var(--primary)'" onblur="this.style.borderColor='#ddd'" required>
          </div>
          <div class="form-group" style="margin-bottom: 2rem;">
            <label style="font-weight: 600; color: var(--text-dark); margin-bottom: 0.5rem; display: block;">How can we help?</label>
            <textarea id="contactMessage" class="form-control" rows="5" placeholder="Tell us about your wellness goals..." style="padding: 1rem; border-radius: 10px; border: 1px solid #ddd; width: 100%; box-shadow: var(--shadow-sm); resize: vertical; transition: border 0.3s;" onfocus="this.style.borderColor='var(--primary)'" onblur="this.style.borderColor='#ddd'" required></textarea>
          </div>
          <button type="submit" class="btn btn-primary" id="contactSubmitBtn" style="width: 100%; padding: 1rem; font-size: 1.1rem; border-radius: 10px; box-shadow: 0 10px 20px rgba(34,197,94,0.3); transition: transform 0.2s;" onmouseover="this.style.transform='translateY(-2px)'" onmouseout="this.style.transform='translateY(0)'">Send Message</button>
        </form>
      </div>
      
    </div>
  </div>
</section>

<script>
  // Handle Form Submission
  document.getElementById('contactForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('contactSubmitBtn');
    
    const name = document.getElementById('contactName').value;
    const email = document.getElementById('contactEmail').value;
    const message = document.getElementById('contactMessage').value;

    if(!name || !email || !message) {
      alert("Please fill in all fields.");
      return;
    }

    const originalText = btn.textContent;
    btn.textContent = 'Sending...';
    btn.disabled = true;

    try {
      const response = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, email, message })
      });
      
      const data = await response.json();
      
      if(data.success) {
        alert(data.message);
        document.getElementById('contactForm').reset();
      } else {
        alert("Error: " + data.message);
      }
    } catch(err) {
      alert("An error occurred while sending the message.");
    } finally {
      btn.textContent = originalText;
      btn.disabled = false;
    }
  });
  // --- THREE.JS TELEPHONIC ANIMATION ---
  const container = document.getElementById('contact-three-canvas');
  
  const scene = new THREE.Scene();
  // Beautiful dark green background (matches the CSS gradient roughly for fallback)
  scene.background = null; // transparent to see CSS gradient

  const camera = new THREE.PerspectiveCamera(50, container.clientWidth / container.clientHeight, 0.1, 1000);
  camera.position.z = 10;

  const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
  renderer.setSize(container.clientWidth, container.clientHeight);
  renderer.setPixelRatio(window.devicePixelRatio);
  container.appendChild(renderer.domElement);

  // Epic Studio Lighting
  const ambientLight = new THREE.AmbientLight(0xffffff, 0.5);
  scene.add(ambientLight);
  
  const dirLight = new THREE.DirectionalLight(0xffffff, 0.8);
  dirLight.position.set(5, 10, 5);
  scene.add(dirLight);

  const backLight = new THREE.DirectionalLight(0x4ade80, 0.8);
  backLight.position.set(-5, -5, -5);
  scene.add(backLight);

  const fillLight = new THREE.PointLight(0xffffff, 0.5);
  fillLight.position.set(0, 0, 5);
  scene.add(fillLight);

  // Group to hold the telephone receiver
  const handsetGroup = new THREE.Group();
  scene.add(handsetGroup);

  // Material for the telephone
  const goldMaterial = new THREE.MeshPhysicalMaterial({
    color: 0xf59e0b,      // Golden yellow
    metalness: 0.8,
    roughness: 0.2,
    clearcoat: 1.0,
    clearcoatRoughness: 0.1
  });

  const greenMaterial = new THREE.MeshPhysicalMaterial({
    color: 0x22c55e,
    metalness: 0.5,
    roughness: 0.2,
    clearcoat: 0.5
  });

  // Create Handset base (handle curve)
  // We'll use a thick Torus segmented to look like an arc
  const arcGeo = new THREE.TorusGeometry(1.5, 0.4, 32, 64, Math.PI);
  const handle = new THREE.Mesh(arcGeo, greenMaterial);
  handle.rotation.x = Math.PI / 2;
  handle.position.y = 1.5;
  handsetGroup.add(handle);

  // Ear/Mouth pieces (caps at the end of the arc)
  // Left cap
  const capGeo = new THREE.CylinderGeometry(0.8, 0.5, 0.8, 32);
  const leftCap = new THREE.Mesh(capGeo, goldMaterial);
  leftCap.position.set(-1.5, 1.5, 0);
  leftCap.rotation.z = Math.PI / 2;
  leftCap.rotation.x = Math.PI / 2;
  leftCap.position.x = -1.6;
  handsetGroup.add(leftCap);

  // Right cap
  const rightCap = new THREE.Mesh(capGeo, goldMaterial);
  rightCap.position.set(1.5, 1.5, 0);
  rightCap.rotation.z = -Math.PI / 2;
  rightCap.rotation.x = Math.PI / 2;
  rightCap.position.x = 1.6;
  handsetGroup.add(rightCap);

  // Add floating abstract sound waves (Rings)
  const waveGroup = new THREE.Group();
  scene.add(waveGroup);

  const waveMats = [
    new THREE.MeshBasicMaterial({ color: 0x4ade80, transparent: true, opacity: 0.6, side: THREE.DoubleSide }),
    new THREE.MeshBasicMaterial({ color: 0xfcd34d, transparent: true, opacity: 0.4, side: THREE.DoubleSide })
  ];

  for(let i=0; i<4; i++) {
    const wGeo = new THREE.RingGeometry(2 + i*0.8, 2.1 + i*0.8, 64);
    const wave = new THREE.Mesh(wGeo, waveMats[i%2]);
    // place behind telephone
    wave.position.z = -2 - i*0.5;
    waveGroup.add(wave);
  }

  // Position the handset
  handsetGroup.position.set(0, -1, 2);
  
  // Interactive mouse
  let mouseX = 0;
  let mouseY = 0;
  let targetRotationX = 0;
  let targetRotationY = 0;
  
  container.addEventListener('mousemove', (e) => {
    const rect = container.getBoundingClientRect();
    const x = e.clientX - rect.left - rect.width / 2;
    const y = e.clientY - rect.top - rect.height / 2;
    // Map to rotation
    targetRotationY = x * 0.002;
    targetRotationX = y * 0.002;
  });

  container.addEventListener('mouseleave', () => {
    targetRotationY = 0;
    targetRotationX = 0;
  });

  const clock = new THREE.Clock();

  function animate() {
    requestAnimationFrame(animate);
    const time = clock.getElapsedTime();

    // Bobbing and resting rotation
    handsetGroup.position.y = -1 + Math.sin(time * 2) * 0.2;
    
    // Core rotation + Mouse Interaction
    handsetGroup.rotation.x += (targetRotationX + Math.sin(time) * 0.1 - handsetGroup.rotation.x) * 0.1;
    handsetGroup.rotation.y += (targetRotationY + Math.cos(time * 0.5) * 0.2 - handsetGroup.rotation.y) * 0.1;
    handsetGroup.rotation.z = Math.sin(time * 1.5) * 0.1;

    // Animate sound waves (pulsing and expanding)
    waveGroup.children.forEach((wave, i) => {
      const scale = 1 + Math.sin(time * 3 - i) * 0.1;
      wave.scale.set(scale, scale, scale);
      wave.rotation.z -= 0.01 * (i+1);
      wave.material.opacity = 0.5 + Math.sin(time * 2 - i) * 0.2;
    });

    renderer.render(scene, camera);
  }
  animate();

  // Resize handler
  window.addEventListener('resize', () => {
    if(container.clientWidth > 0) {
      const width = container.clientWidth;
      const height = container.clientHeight;
      renderer.setSize(width, height);
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
    }
  });
</script>