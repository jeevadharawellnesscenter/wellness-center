<!-- Load Three.js -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>

<div class="page-breadcrumb">
  <div class="container">
    <a href="/">Home</a> &gt; <span style="color: var(--primary); font-weight: 500;">Services</span>
  </div>
</div>

<section class="page-hero" style="position: relative; overflow: hidden; padding: 6rem 0;">
  <!-- Three.js Canvas Container -->
  <div id="services-three-bg" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 0;"></div>

  <div class="container hero-content" style="text-align: center; z-index: 2; position: relative; padding-right: 0; background: rgba(255,255,255,0.1); backdrop-filter: blur(8px); padding: 3rem; border-radius: 20px; border: 1px solid rgba(255,255,255,0.2); box-shadow: 0 20px 40px rgba(0,0,0,0.1);">
    <h1 style="text-shadow: 0 4px 15px rgba(0,0,0,0.2); color: white; margin-bottom: 1rem; font-size: 3.5rem;">Our Services</h1>
    <p style="max-width: 600px; margin: 0 auto; font-size: 1.25rem; color: #f8fcf8; text-shadow: 0 2px 5px rgba(0,0,0,0.2); line-height: 1.6;">
      Choose between our world-class clinic therapies or convenient virtual guidance programs designed for your holistic well-being.
    </p>
  </div>
</section>

<section class="section" style="padding-top: 5rem; background: linear-gradient(to bottom, #f9fbf9, #ffffff);">
  <div class="container">
    <div class="services-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 3rem;">
      <!-- Online Services Category Card -->
      <div class="service-card category-card" style="transition: transform 0.3s ease, box-shadow 0.3s ease; border-radius: 20px; overflow: hidden; background: white; box-shadow: 0 10px 30px rgba(0,0,0,0.05); padding: 3rem 2rem; text-align: center; position: relative;" onmouseover="this.style.transform='translateY(-10px)'; this.style.boxShadow='0 20px 40px rgba(0,0,0,0.1)'" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 10px 30px rgba(0,0,0,0.05)'">
        <div class="category-icon" style="font-size: 4rem; margin-bottom: 1.5rem; text-shadow: 0 10px 20px rgba(0,0,0,0.1);">🌐</div>
        <h3 style="margin-bottom: 1rem; font-size: 2rem; color: var(--primary-dark);">Online Services</h3>
        <p style="color: var(--text-light); margin-bottom: 2.5rem; font-size: 1.1rem; line-height: 1.6;">Connect with our world-class experts virtually. Includes Yoga, Diet plans, Consultation, and Counselling.</p>
        <a href="/services/online" class="btn btn-outline" style="border-width: 2px; border-radius: 30px; padding: 0.8rem 2.5rem; font-weight: 600; text-transform: uppercase; letter-spacing: 1px;">View Details</a>
      </div>

      <!-- Offline Services Category Card -->
      <div class="service-card category-card" style="transition: transform 0.3s ease, box-shadow 0.3s ease; border-radius: 20px; overflow: hidden; background: white; box-shadow: 0 10px 30px rgba(0,0,0,0.05); padding: 3rem 2rem; text-align: center; position: relative;" onmouseover="this.style.transform='translateY(-10px)'; this.style.boxShadow='0 20px 40px rgba(0,0,0,0.1)'" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 10px 30px rgba(0,0,0,0.05)'">
        <div class="category-icon" style="font-size: 4rem; margin-bottom: 1.5rem; text-shadow: 0 10px 20px rgba(0,0,0,0.1);">🏥</div>
        <h3 style="margin-bottom: 1rem; font-size: 2rem; color: var(--primary-dark);">Offline Services</h3>
        <p style="color: var(--text-light); margin-bottom: 2.5rem; font-size: 1.1rem; line-height: 1.6;">Experience our therapies and wellness programs in-person at Jeevadhara Clinic. Includes Mud therapy, Counselling, and Consultation.</p>
        <a href="/services/offline" class="btn btn-outline" style="border-width: 2px; border-radius: 30px; padding: 0.8rem 2.5rem; font-weight: 600; text-transform: uppercase; letter-spacing: 1px;">View Details</a>
      </div>
    </div>
  </div>
</section>

<!-- ThreeJS Animation Logic -->
<script>
  const bgContainer = document.getElementById('services-three-bg');
  
  const scene = new THREE.Scene();
  // Using a deep elegant green similar to the current hero color but dynamic
  scene.background = new THREE.Color('#1a3f2b');
  // Add a slight fog to give it depth
  scene.fog = new THREE.FogExp2('#1a3f2b', 0.05);

  const camera = new THREE.PerspectiveCamera(75, bgContainer.clientWidth / bgContainer.clientHeight, 0.1, 1000);
  camera.position.z = 15;

  const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
  renderer.setSize(bgContainer.clientWidth, bgContainer.clientHeight);
  renderer.setPixelRatio(window.devicePixelRatio);
  bgContainer.appendChild(renderer.domElement);

  // Lighting
  const ambientLight = new THREE.AmbientLight(0xffffff, 0.4);
  scene.add(ambientLight);

  const pointLight = new THREE.PointLight(0xaaffcc, 1, 100);
  pointLight.position.set(5, 5, 5);
  scene.add(pointLight);
  
  const pointLight2 = new THREE.PointLight(0xccffea, 0.8, 100);
  pointLight2.position.set(-10, -5, 2);
  scene.add(pointLight2);

  // Create floating wellness elements 
  // (We'll use elegant abstract geometrical toruses and spheres)
  const group = new THREE.Group();
  scene.add(group);

  const geometry1 = new THREE.TorusGeometry(3, 0.8, 16, 100);
  const material1 = new THREE.MeshPhysicalMaterial({ 
    color: 0x4ade80, 
    metalness: 0.1,
    roughness: 0.5,
    transparent: true,
    opacity: 0.8,
    wireframe: true
  });
  const torus = new THREE.Mesh(geometry1, material1);
  torus.position.set(-6, 2, -5);
  group.add(torus);

  const geometry2 = new THREE.IcosahedronGeometry(2, 1);
  const material2 = new THREE.MeshPhysicalMaterial({ 
    color: 0x86efac, 
    metalness: 0.3,
    roughness: 0.2,
    transparent: true,
    opacity: 0.6 
  });
  const icosahedron = new THREE.Mesh(geometry2, material2);
  icosahedron.position.set(7, -3, -8);
  group.add(icosahedron);
  
  const geometry3 = new THREE.SphereGeometry(1.5, 32, 32);
  const material3 = new THREE.MeshPhysicalMaterial({ 
    color: 0x22c55e,
    clearcoat: 1.0,
    clearcoatRoughness: 0.1,
    transparent: true,
    opacity: 0.7
  });
  const sphere = new THREE.Mesh(geometry3, material3);
  sphere.position.set(0, -6, -2);
  group.add(sphere);

  // Particles (Dust particles for calming vibe)
  const particlesGeo = new THREE.BufferGeometry();
  const particlesCount = 400;
  const posArray = new Float32Array(particlesCount * 3);
  for(let i = 0; i < particlesCount * 3; i++) {
    // Spread them across the scene
    posArray[i] = (Math.random() - 0.5) * 40; 
  }
  particlesGeo.setAttribute('position', new THREE.BufferAttribute(posArray, 3));
  const particlesMat = new THREE.PointsMaterial({
    size: 0.05,
    color: 0xffffff,
    transparent: true,
    opacity: 0.8,
    blending: THREE.AdditiveBlending
  });
  const particlesMesh = new THREE.Points(particlesGeo, particlesMat);
  scene.add(particlesMesh);

  // Interactive mouse movement
  let mouseX = 0;
  let mouseY = 0;
  let targetX = 0;
  let targetY = 0;
  const windowHalfX = window.innerWidth / 2;
  const windowHalfY = window.innerHeight / 2;

  document.addEventListener('mousemove', (event) => {
    mouseX = (event.clientX - windowHalfX);
    mouseY = (event.clientY - windowHalfY);
  });

  // Animation Loop
  const clock = new THREE.Clock();

  function animate() {
    requestAnimationFrame(animate);
    const elapsedTime = clock.getElapsedTime();

    // Rotate objects gracefully
    torus.rotation.x = 0.2 * elapsedTime;
    torus.rotation.y = 0.15 * elapsedTime;
    
    icosahedron.rotation.x = -0.1 * elapsedTime;
    icosahedron.rotation.y = -0.2 * elapsedTime;

    sphere.position.y = -6 + Math.sin(elapsedTime * 0.5) * 2;

    // Rotate the whole group slowly
    group.rotation.x += 0.001;
    group.rotation.y += 0.002;
    
    // Float particles up and rotate
    particlesMesh.rotation.y = -0.05 * elapsedTime;
    
    // Parallax effect with mouse
    targetX = mouseX * 0.001;
    targetY = mouseY * 0.001;
    
    camera.rotation.x += 0.05 * (targetY - camera.rotation.x);
    camera.rotation.y += 0.05 * (targetX - camera.rotation.y);

    renderer.render(scene, camera);
  }
  animate();

  // Handle Resize
  window.addEventListener('resize', () => {
    const width = bgContainer.clientWidth;
    const height = bgContainer.clientHeight;
    renderer.setSize(width, height);
    camera.aspect = width / height;
    camera.updateProjectionMatrix();
  });
</script>