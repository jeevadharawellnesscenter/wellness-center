<div class="container dashboard-grid">
  <aside class="sidebar">
    <h3>Admin Panel</h3>
    <ul class="sidebar-nav">
      <li><a href="/admin" class="<%= currentPath === '/admin' ? 'active' : '' %>">Dashboard Overview</a></li>
      <li><a href="/admin/services">Manage Services</a></li>
      <li><a href="/admin/blogs">Manage Blogs</a></li>
      <li><a href="/admin/practitioners">Manage Practitioners</a></li>
      <li><a href="/admin/subscribers">Newsletter Subscribers</a></li>
      <li><a href="/dashboard">User View</a></li>
      <li><a href="/api/auth/logout" style="color: #e74c3c; margin-top: 2rem;">Logout</a></li>
    </ul>
  </aside>

  <main class="dash-content">
    <div class="dash-header">
      <div>
        <h2>Welcome, Administrator</h2>
        <p style="color: var(--text-light); margin-top: 0.5rem;">Here's what's happening at your center today.</p>
      </div>
    </div>

    <!-- Executive Summary Cards -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 2rem; margin-bottom: 3.5rem;">
      <div style="background: var(--white); padding: 2.5rem; border-radius: 30px; position: relative; overflow: hidden; box-shadow: var(--shadow-md); border: 1px solid rgba(0,0,0,0.02);">
          <div style="position: absolute; top: -20px; right: -20px; width: 100px; height: 100px; background: rgba(18,53,36,0.03); border-radius: 50%;"></div>
          <h4 style="color: var(--text-light); font-size: 0.75rem; margin-bottom: 1rem; text-transform: uppercase; letter-spacing: 2px; font-weight: 600;">Global Presence</h4>
          <p style="font-size: 3rem; font-weight: 700; color: var(--primary); letter-spacing: -2px;"><%= stats.usersCount %></p>
          <span style="font-size: 0.8rem; color: #2ecc71; font-weight: 600;">+12% vs last month</span>
      </div>
      <div style="background: var(--white); padding: 2.5rem; border-radius: 30px; position: relative; overflow: hidden; box-shadow: var(--shadow-md); border: 1px solid rgba(0,0,0,0.02);">
          <div style="position: absolute; top: -20px; right: -20px; width: 100px; height: 100px; background: rgba(207,157,64,0.05); border-radius: 50%;"></div>
          <h4 style="color: var(--text-light); font-size: 0.75rem; margin-bottom: 1rem; text-transform: uppercase; letter-spacing: 2px; font-weight: 600;">Service Volume</h4>
          <p style="font-size: 3rem; font-weight: 700; color: var(--accent); letter-spacing: -2px;"><%= stats.appointmentsCount %></p>
          <span style="font-size: 0.8rem; color: var(--accent); font-weight: 600;">Peak Performance</span>
      </div>
      <div style="background: var(--white); padding: 2.5rem; border-radius: 30px; position: relative; overflow: hidden; box-shadow: var(--shadow-md); border: 1px solid rgba(0,0,0,0.02);">
          <div style="position: absolute; top: -20px; right: -20px; width: 100px; height: 100px; background: rgba(52,152,219,0.05); border-radius: 50%;"></div>
          <h4 style="color: var(--text-light); font-size: 0.75rem; margin-bottom: 1rem; text-transform: uppercase; letter-spacing: 2px; font-weight: 600;">Network Pulse</h4>
          <p style="font-size: 3rem; font-weight: 700; color: #3498db; letter-spacing: -2px;"><%= stats.activitiesCount %></p>
          <span style="font-size: 0.8rem; color: #3498db; font-weight: 600;">Optimized & Healthy</span>
      </div>
    </div>

    <!-- Analytics Charts -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(400px, 1fr)); gap: 3rem; margin-bottom: 5rem;">
        <div style="background: white; padding: 2rem; border-radius: 25px; box-shadow: var(--shadow-sm); border: 1px solid rgba(0,0,0,0.02);">
            <h3 style="margin-bottom: 2rem; font-size: 1.2rem; color: var(--primary);">User Registration Growth</h3>
            <canvas id="userChart" height="200"></canvas>
        </div>
        <div style="background: white; padding: 2rem; border-radius: 25px; box-shadow: var(--shadow-sm); border: 1px solid rgba(0,0,0,0.02);">
            <h3 style="margin-bottom: 2rem; font-size: 1.2rem; color: var(--primary);">Appointment Status Breakdown</h3>
            <canvas id="aptChart" height="200"></canvas>
        </div>
    </div>
    
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
      // Appointment Chart
      const aptCtx = document.getElementById('aptChart');
      new Chart(aptCtx, {
        type: 'doughnut',
        data: {
          labels: ['Completed', 'Scheduled', 'Cancelled'],
          datasets: [{
            data: [12, 19, 3],
            backgroundColor: ['#123524', '#CF9D40', '#e74c3c'],
            hoverOffset: 15,
            borderWidth: 0
          }]
        },
        options: {
          cutout: '75%',
          plugins: { 
            legend: { 
              position: 'bottom',
              labels: { usePointStyle: true, padding: 20, font: { family: 'Outfit' } }
            } 
          }
        }
      });

      // User Registration Growth Chart
      const userCtx = document.getElementById('userChart');
      new Chart(userCtx, {
        type: 'line',
        data: {
          labels: ['Week 1', 'Week 2', 'Week 3', 'Week 4'],
          datasets: [{
            label: 'New Registrations',
            data: [2, 15, 8, <%= stats.usersCount %>],
            borderColor: '#CF9D40',
            backgroundColor: (context) => {
              const chart = context.chart;
              const {ctx, chartArea} = chart;
              if (!chartArea) return null;
              const gradient = ctx.createLinearGradient(0, chartArea.bottom, 0, chartArea.top);
              gradient.addColorStop(0, 'rgba(207,157,64,0)');
              gradient.addColorStop(1, 'rgba(207,157,64,0.2)');
              return gradient;
            },
            fill: true,
            tension: 0.5,
            pointRadius: 6,
            pointBackgroundColor: '#fff',
            pointBorderColor: '#CF9D40',
            pointBorderWidth: 2
          }]
        },
        options: {
          responsive: true,
          plugins: { legend: { display: false } },
          scales: { 
            y: { display: false, beginAtZero: true },
            x: { grid: { display: false } }
          }
        }
      });
    </script>

    <!-- Recent Activities Table -->
    <div style="margin-bottom: 4rem;">
      <h3 style="margin-bottom: 1.5rem; font-size: 1.6rem; color: var(--primary);">System Activities</h3>
      <div style="overflow-x: auto;">
        <table style="width: 100%; border-collapse: collapse; text-align: left; background: var(--white); border-radius: 20px; overflow: hidden; box-shadow: var(--shadow-sm);">
          <thead>
            <tr style="background: var(--primary-light); color: var(--white);">
              <th style="padding: 1.2rem; font-weight: 500;">Action</th>
              <th style="padding: 1.2rem; font-weight: 500;">Description</th>
              <th style="padding: 1.2rem; font-weight: 500;">User Email</th>
              <th style="padding: 1.2rem; font-weight: 500;">Time</th>
            </tr>
          </thead>
          <tbody>
            <% if (recentActivities && recentActivities.length > 0) { %>
              <% recentActivities.forEach(activity => { %>
                <tr style="border-bottom: 1px solid rgba(0,0,0,0.05); transition: var(--transition);">
                  <td style="padding: 1.2rem; font-weight: 600; color: var(--primary);"><%= activity.action %></td>
                  <td style="padding: 1.2rem; color: var(--text-light);"><%= activity.description %></td>
                  <td style="padding: 1.2rem; color: var(--text-light);"><%= activity.userEmail || (activity.user && activity.user.email) || 'System' %></td>
                  <td style="padding: 1.2rem; color: var(--text-light); font-size: 0.9rem;"><%= new Date(activity.timestamp).toLocaleString() %></td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="4" style="padding: 2rem; text-align: center; color: var(--text-light);">No activities found.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Recent Appointments Table -->
    <div>
      <h3 style="margin-bottom: 1.5rem; font-size: 1.6rem; color: var(--primary);">Recent Appointments</h3>
      <div style="overflow-x: auto;">
        <table style="width: 100%; border-collapse: collapse; text-align: left; background: var(--white); border-radius: 20px; overflow: hidden; box-shadow: var(--shadow-sm);">
          <thead>
            <tr style="background: var(--accent); color: var(--white);">
              <th style="padding: 1.2rem; font-weight: 500;">User Email</th>
              <th style="padding: 1.2rem; font-weight: 500;">Service</th>
              <th style="padding: 1.2rem; font-weight: 500;">Date & Time</th>
              <th style="padding: 1.2rem; font-weight: 500;">Status</th>
            </tr>
          </thead>
          <tbody>
            <% if (recentAppointments && recentAppointments.length > 0) { %>
              <% recentAppointments.forEach(apt => { %>
                <tr style="border-bottom: 1px solid rgba(0,0,0,0.05);">
                  <td style="padding: 1.2rem; font-weight: 500;"><%= apt.user ? apt.user.email : 'Unknown' %></td>
                  <td style="padding: 1.2rem; color: var(--primary);"><%= apt.service ? apt.service.name : 'Unknown' %></td>
                  <td style="padding: 1.2rem; color: var(--text-light);"><%= new Date(apt.date).toLocaleDateString() %> at <%= apt.time %></td>
                  <td style="padding: 1.2rem;">
                    <% 
                      let badgeBg = '#fff3e0';
                      let badgeColor = '#ef6c00';
                      if(apt.status === 'scheduled') { badgeBg = '#e1f5fe'; badgeColor = '#0288d1'; }
                      if(apt.status === 'completed') { badgeBg = '#e8f5e9'; badgeColor = '#2e7d32'; }
                      let badgeStyleAttr = `style="padding: 0.4rem 0.8rem; border-radius: 50px; font-size: 0.8rem; font-weight: 600; background-color: ${badgeBg}; color: ${badgeColor};"`;
                    %>
                    <span <%- badgeStyleAttr %>>
                      <%= apt.status.toUpperCase() %>
                    </span>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="4" style="padding: 2rem; text-align: center; color: var(--text-light);">No appointments found.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Registered Customers Table -->
    <div style="margin-top: 4rem;">
      <h3 style="margin-bottom: 1.5rem; font-size: 1.6rem; color: var(--primary);">Registered Customers</h3>
      <div style="overflow-x: auto;">
        <table style="width: 100%; border-collapse: collapse; text-align: left; background: var(--white); border-radius: 20px; overflow: hidden; box-shadow: var(--shadow-sm);">
          <thead>
            <tr style="background: var(--primary-dark); color: var(--white);">
              <th style="padding: 1.2rem; font-weight: 500;">Name</th>
              <th style="padding: 1.2rem; font-weight: 500;">Email</th>
              <th style="padding: 1.2rem; font-weight: 500;">Role</th>
              <th style="padding: 1.2rem; font-weight: 500;">Joined Date</th>
            </tr>
          </thead>
          <tbody>
            <% if (allUsers && allUsers.length > 0) { %>
              <% allUsers.forEach(u => { %>
                <tr style="border-bottom: 1px solid rgba(0,0,0,0.05);">
                  <td style="padding: 1.2rem; font-weight: 500; color: var(--text-dark);"><%= u.name || 'N/A' %></td>
                  <td style="padding: 1.2rem; color: var(--text-light);"><%= u.email %></td>
                  <td style="padding: 1.2rem;">
                    <% if(u.role === 'admin') { %>
                      <span style="padding: 0.3rem 0.6rem; background: #fee2e2; color: #b91c1c; border-radius: 5px; font-size:0.8rem; font-weight: bold;">ADMIN</span>
                    <% } else { %>
                      <span style="padding: 0.3rem 0.6rem; background: #f0fdf4; color: #15803d; border-radius: 5px; font-size:0.8rem; font-weight: bold;">CUSTOMER</span>
                    <% } %>
                  </td>
                  <td style="padding: 1.2rem; color: var(--text-light); font-size: 0.9rem;"><%= new Date(u.createdAt).toLocaleDateString() %></td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="4" style="padding: 2rem; text-align: center; color: var(--text-light);">No registered customers yet.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>
