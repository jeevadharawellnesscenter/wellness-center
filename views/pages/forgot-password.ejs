<div class="auth-wrapper">
  <div class="auth-card">
    <h2>Forgot Password</h2>
    <p style="text-align: center; margin-bottom: 2rem; color: #666;">Enter your email and we'll generate a reset link.</p>
    <form id="forgotForm">
      <div class="form-group">
        <label for="email">Email Address</label>
        <input type="email" id="email" class="form-control" required placeholder="Enter your email">
      </div>
      <div id="error-msg" class="form-error"></div>
      <div id="success-msg" class="form-success" style="display: none; color: green; margin-bottom: 1rem; text-align: center; word-break: break-all;"></div>
      <button type="submit" class="btn btn-primary">Generate Reset Link</button>
    </form>
    <div class="auth-switch">
      Remember your password? <a href="/login">Log In</a>
    </div>
  </div>
</div>

<script>
  document.getElementById('forgotForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = document.getElementById('email').value;
    const btn = e.target.querySelector('button');
    btn.textContent = 'Generating...';
    btn.disabled = true;

    try {
      const res = await fetch('/api/auth/forgot-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email })
      });
      const data = await res.json();

      if (data.success) {
        document.getElementById('error-msg').style.display = 'none';
        const succ = document.getElementById('success-msg');
        succ.style.display = 'block';
        succ.innerHTML = `${data.message}<br><br><a href="${data.resetUrl}" style="color: var(--primary); font-weight: bold;">Click here to reset your password</a>`;
        btn.style.display = 'none';
      } else {
        const err = document.getElementById('error-msg');
        err.style.display = 'block';
        err.textContent = data.message || 'Request failed';
        btn.textContent = 'Generate Reset Link';
        btn.disabled = false;
      }
    } catch (err) {
      console.log(err);
      btn.textContent = 'Generate Reset Link';
      btn.disabled = false;
    }
  });
</script>
