<div style="background: var(--bg-light); padding: 1rem 0; border-bottom: 1px solid #eaeaea;">
  <div class="container" style="font-size: 0.9rem; color: var(--text-light);">
    <a href="/">Home</a> &gt; <a href="/services">Services</a> &gt; <span
      style="color: var(--primary); font-weight: 500;">Offline</span>
  </div>
</div>

<section class="hero"
  style="min-height: 35vh; background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%); color: var(--white);">
  <div class="container" style="text-align: center; z-index: 2;">
    <h1 style="color: white; margin-top: 2rem;">Offline Services</h1>
    <p style="color: rgba(255,255,255,0.8); max-width: 600px; margin: 1rem auto;">Experience meticulously curated
      therapies and wellness programs in-person at Jeevadhara Clinic.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="services-grid" id="offline-services-list">
      <p style="text-align: center; width: 100%; color: var(--text-light);">Loading clinic services...</p>
    </div>
  </div>
</section>

<!-- Booking Modal -->
<div id="bookingModal"
  style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 2000; align-items: center; justify-content: center;">
  <div
    style="background: white; padding: 2.5rem; border-radius: 20px; width: 90%; max-width: 450px; box-shadow: var(--shadow-lg); position: relative;">
    <button onclick="closeModal()"
      style="position: absolute; top: 1rem; right: 1.5rem; background: transparent; border: none; font-size: 1.5rem; cursor: pointer; color: var(--text-light);">&times;</button>
    <h3 style="margin-bottom: 0.5rem;" id="modalServiceName">Service Name</h3>
    <p style="display: none;" id="modalServicePrice">$0</p>
    <p style="font-size: 0.85rem; color: var(--text-light); margin-bottom: 1.5rem;" id="modalServiceLocation">📍
      Location: Jeevadhara Clinic Headquarters</p>

    <div class="form-group">
      <label>Select Date</label>
      <input type="date" id="bookingDate" class="form-control" required>
    </div>

    <div class="form-group">
      <label>Select Time Slot</label>
      <select id="bookingTime" class="form-control" required style="background: white;">
        <option value="" disabled selected>Select a time</option>
        <option value="09:00 AM">09:00 AM - 10:00 AM</option>
        <option value="11:30 AM">11:30 AM - 12:30 PM</option>
        <option value="02:00 PM">02:00 PM - 03:00 PM</option>
        <option value="05:00 PM">05:00 PM - 06:00 PM</option>
      </select>
    </div>

    <input type="hidden" id="bookingServiceId">

    <button onclick="confirmBooking()" class="btn btn-primary" style="width: 100%; margin-top: 1rem;">Book
      Appointment</button>
  </div>
</div>

<script>
  const today = new Date().toISOString().split('T')[0];
  document.getElementById('bookingDate').setAttribute('min', today);

  async function fetchOfflineServices() {
    try {
      const res = await fetch('/api/services');
      const data = await res.json();
      const list = document.getElementById('offline-services-list');

      if (data.success && data.count > 0) {
        const offlineData = data.data.filter(srv => srv.category === 'offline');

        if (offlineData.length === 0) {
          list.innerHTML = '<p style="color: var(--text-light); text-align: center; width: 100%;">No offline services available at the moment.</p>';
          return;
        }

        let html = '';
        const defaultImages = [
          'https://images.unsplash.com/photo-1519823551278-64ac92734fb1?auto=format&fit=crop&q=80&w=800'
        ];

        offlineData.forEach((srv, index) => {
          let finalImg = srv.image && srv.image !== '/images/default-service.jpg' ? srv.image : null;
          if (!finalImg) {
            const name = srv.name.toLowerCase();
            if (name.includes('yoga') || name.includes('massage') || name.includes('spa')) finalImg = 'https://images.unsplash.com/photo-1544161515-4ab6ce6db874?auto=format&fit=crop&q=80&w=800';
            else if (name.includes('diet') || name.includes('nutrition') || name.includes('detox')) finalImg = 'https://images.unsplash.com/photo-1512621776951-a57141f2eefd?auto=format&fit=crop&q=80&w=800';
            else if (name.includes('consult') || name.includes('therapy')) finalImg = 'https://images.unsplash.com/photo-1551836022-d5d88e9218df?auto=format&fit=crop&q=80&w=800';
            else if (name.includes('stress')) finalImg = 'https://images.unsplash.com/photo-1506126613408-eca07ce68773?auto=format&fit=crop&q=80&w=800';
            else finalImg = defaultImages[index % defaultImages.length];
          }

          html += `
            <div class="service-card" style="box-shadow: var(--shadow-md); position: relative; overflow: hidden; transition: transform 0.3s ease;" onmouseover="this.style.transform='translateY(-5px)'" onmouseout="this.style.transform='translateY(0)'">
              <div class="service-img" style="background-image: url('${finalImg}'); height: 180px;"></div>
              <div class="service-content">
                <div style="font-size: 0.8rem; margin-bottom: 0.8rem; background: var(--secondary); color: var(--accent); padding: 0.4rem 0.8rem; border-radius: 5px; display: inline-block;">
                  📍 ${srv.location || 'Jeevadhara Clinic Headquarters'} | 🕒 ${srv.schedule || 'Mon-Fri, 9AM-6PM'}
                </div>
                <h3 style="margin-top: 0.5rem;">${srv.name}</h3>
                <p style="font-size: 0.95rem;">${srv.description}</p>
                <div class="service-footer" style="padding-top: 1.5rem;">
                  <button class="btn btn-primary" style="padding: 0.6rem 1.5rem; font-size: 0.9rem;" onclick="openBookingModal('${srv._id}', '${srv.name.replace(/'/g, "\\'")}', ${srv.price}, '${srv.location}')">Book Appointment</button>
                </div>
              </div>
            </div>
          `;
        });
        list.innerHTML = html;
      } else {
        list.innerHTML = '<p style="color: var(--text-light); text-align: center; width: 100%;">No services available.</p>';
      }
    } catch (err) {
      console.log(err);
      document.getElementById('offline-services-list').innerHTML = '<p style="color: red; text-align: center; width: 100%;">Failed to load services.</p>';
    }
  }

  function openBookingModal(id, name, price, location) {
    document.getElementById('bookingServiceId').value = id;
    document.getElementById('modalServiceName').textContent = name;
    document.getElementById('modalServicePrice').textContent = '$' + price;
    if (location && location !== 'undefined') {
      document.getElementById('modalServiceLocation').textContent = '📍 Location: ' + location;
    }
    document.getElementById('bookingModal').style.display = 'flex';
  }
  function closeModal() { document.getElementById('bookingModal').style.display = 'none'; }

  async function confirmBooking() {
    const serviceId = document.getElementById('bookingServiceId').value;
    const dateStr = document.getElementById('bookingDate').value;
    const timeStr = document.getElementById('bookingTime').value;

    if (!dateStr || !timeStr) { alert("Please select both a valid date and a time slot."); return; }

    try {
      const res = await fetch('/api/appointments', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ serviceId, date: dateStr, time: timeStr })
      });
      const data = await res.json();
      if (data.success) {
        alert('✅ Appointment Booked! The clinic has been notified via WhatsApp.');
        // Open WhatsApp notification to clinic automatically
        if (data.whatsappNotifyUrl) {
          window.open(data.whatsappNotifyUrl, '_blank');
        }
        window.location.href = '/dashboard';
      } else {
        if (res.status === 401) window.location.href = '/login';
        else alert('Booking failed: ' + data.message);
      }
    } catch (err) { console.error(err); alert('Error booking appointment'); }
  }

  fetchOfflineServices();
</script>