<style>
  .zen-hero {
    background: linear-gradient(135deg, #0f1c14 0%, #1e3f2b 100%);
    padding: 8rem 0 4rem;
    text-align: center;
    color: white;
    position: relative;
    overflow: hidden;
  }
  .zen-hero::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(74, 222, 128, 0.1) 0%, transparent 70%);
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .breathing-room {
    padding: 6rem 0;
    background: radial-gradient(circle at center, #102a1d 0%, #050f0a 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
    overflow: hidden;
    min-height: 80vh;
  }

  /* Three.js Container */
  #three-canvas-container {
    width: 100%;
    height: 500px;
    position: relative;
    cursor: grab;
    margin: 2rem 0;
    z-index: 5;
  }

  .breathing-instruction {
    font-size: 1.5rem;
    font-family: var(--font-serif);
    color: rgba(255,255,255,0.7);
    margin-top: 1rem;
    min-height: 2rem;
    position: relative;
    z-index: 10;
  }

  /* Overlay text for the 3D object */
  #three-overlay-text {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: white;
    font-weight: 700;
    font-size: 1.5rem;
    pointer-events: none;
    text-shadow: 0 0 20px rgba(0,0,0,0.5);
    z-index: 15;
    letter-spacing: 2px;
    text-transform: uppercase;
  }


  .resource-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2.5rem;
    margin-top: 4rem;
  }

  .resource-card {
    background: white;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    border: 1px solid rgba(0,0,0,0.02);
  }

  .resource-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.1);
  }

  .resource-img {
    width: 100%;
    height: 200px;
    object-fit: cover;
  }

  .resource-content {
    padding: 2rem;
  }

  .resource-tag {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--accent);
    font-weight: 700;
    margin-bottom: 0.5rem;
    display: block;
  }

  .resource-title {
    font-size: 1.25rem;
    color: var(--text-dark);
    margin-bottom: 1rem;
    font-family: var(--font-serif);
  }

  .resource-desc {
    font-size: 0.95rem;
    color: var(--text-light);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .btn-zen {
    background: transparent;
    border: 2px solid var(--primary);
    color: var(--primary);
    padding: 0.6rem 1.5rem;
    border-radius: 30px;
    font-weight: 600;
    font-size: 0.9rem;
    transition: all 0.3s;
  }

  .btn-zen:hover {
    background: var(--primary);
    color: white;
  }

  .timer-display {
    font-size: 3rem;
    font-family: var(--font-serif);
    color: var(--accent);
    margin-bottom: 1rem;
    text-shadow: 0 0 15px rgba(207,157,64,0.3);
  }
</style>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<section class="zen-hero" style="color: white; color: white !important;">
  <div class="container">
    <h1 data-i18n="zen_hero_title" style="font-size: clamp(3rem, 8vw, 5rem); font-family: var(--font-serif); margin-bottom: 1.5rem; color: white;">The Zen Zone</h1>
    <p data-i18n="zen_hero_desc" style="font-size: 1.2rem; color: rgba(255,255,255,0.8); max-width: 700px; margin: 0 auto; line-height: 1.8;">
      Welcome to your sanctuary of stillness. Regulate your energy, restore your focus, and explore the wisdom of natural healing.
    </p>
  </div>
</section>

<section class="breathing-room">
  <div class="container" style="max-width: 800px;">
    <span style="letter-spacing: 5px; text-transform: uppercase; font-size: 0.8rem; color: var(--accent); font-weight: 600;">Mindfulness Practice</span>
    <h2 data-i18n="breath_title" style="margin-top: 1rem; margin-bottom: 1.5rem; color: white;">Regulate Your Breath</h2>
    <p style="color: rgba(255,255,255,0.7); font-size: 1.1rem; line-height: 1.7;">
      Use this interactive guide to practice the 4-7-8 breathing technique, a natural tranquilizer for the nervous system.
    </p>
    </div>

    <div id="zen-timer" class="timer-display">00:00</div>

    <div id="three-canvas-container">
      <div id="three-overlay-text" data-i18n="breath_ready">Ready?</div>
    </div>

    <div class="breathing-instruction" id="breathing-detail" data-i18n="breath_start_desc">Press Start to begin your immersive 3D session.</div>

    <div style="margin-top: 3rem; display: flex; gap: 1rem; justify-content: center; position: relative; z-index: 20;">
        <button id="start-breath" data-i18n="breath_start" class="btn btn-primary" style="padding: 1rem 2.5rem; border-radius: 30px; box-shadow: 0 0 20px rgba(207,157,64,0.2);">Start Session</button>
        <button id="stop-breath" data-i18n="breath_stop" class="btn btn-outline" style="padding: 1rem 2.5rem; border-radius: 30px; display: none; color: white; border-color: white;">Stop Session</button>
    </div>
  </div>
</section>

<section class="section" style="background: white; padding-bottom: 8rem;">
  <div class="container">
    <div style="text-align: center; margin-bottom: 4rem;">
      <h2 style="font-family: var(--font-serif); color: var(--primary-dark); font-size: 2.5rem;">Wellness Library</h2>
      <p style="color: var(--text-light); max-width: 600px; margin: 1rem auto;">Curated resources to deepen your understanding of holistic health.</p>
    </div>

    <div class="resource-grid">
      <!-- Card 1 -->
      <div class="resource-card">
        <img src="/img/hydrotherapy.png" alt="Hydrotherapy" class="resource-img">
        <div class="resource-content">
          <span class="resource-tag">Hydrotherapy</span>
          <h3 class="resource-title">The Power of Water</h3>
          <p class="resource-desc">Discover how varying water temperatures can stimulate blood flow and enhance your body's natural defense mechanisms.</p>
          <a href="/zen-zone/hydrotherapy" class="btn-zen">Read Guide</a>
        </div>
      </div>

      <!-- Card 2 -->
      <div class="resource-card">
        <img src="/img/mud_therapy.png" alt="Mud Therapy" class="resource-img">
        <div class="resource-content">
          <span class="resource-tag">Detox</span>
          <h3 class="resource-title">Earth's Healing Touch</h3>
          <p class="resource-desc">Explore the ancient practice of mud therapy for skin rejuvenation and deep toxin removal from the systemic layers.</p>
          <a href="/zen-zone/mud-therapy" class="btn-zen">Explore More</a>
        </div>
      </div>

      <!-- Card 3 -->
      <div class="resource-card">
        <img src="/img/meditation.png" alt="Meditation" class="resource-img">
        <div class="resource-content">
          <span class="resource-tag">Mindfulness</span>
          <h3 class="resource-title">Inner Stillness</h3>
          <p class="resource-desc">A beginner's guide to Vipassana and Zen meditation techniques for mental clarity and emotional resilience.</p>
          <a href="/zen-zone/meditation" class="btn-zen">Start Learning</a>
        </div>
      </div>

      <!-- Card 4 -->
      <div class="resource-card">
        <img src="/img/diet.png" alt="Nutrition" class="resource-img">
        <div class="resource-content">
          <span class="resource-tag">Nutrition</span>
          <h3 class="resource-title">Nature's Harvest</h3>
          <p class="resource-desc">How to align your diet with the seasons using whole-food, plant-based principles for optimal vitality.</p>
          <a href="/zen-zone/nutrition" class="btn-zen">View Recipes</a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // THREE.JS IMPLEMENTATION
  const container = document.getElementById('three-canvas-container');
  const overlayText = document.getElementById('three-overlay-text');
  
  let scene, camera, renderer, sphere, clouds;
  let isBreathing = false;
  let breathingState = 'ready'; // ready, inhale, hold, exhale
  let clock = new THREE.Clock();

  function initThree() {
    scene = new THREE.Scene();
    
    camera = new THREE.PerspectiveCamera(75, container.clientWidth / container.clientHeight, 0.1, 1000);
    camera.position.z = 5;

    renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setSize(container.clientWidth, container.clientHeight);
    renderer.setPixelRatio(window.devicePixelRatio);
    container.appendChild(renderer.domElement);

    // Lights
    const ambientLight = new THREE.AmbientLight(0xffffff, 0.5);
    scene.add(ambientLight);

    const pointLight = new THREE.PointLight(0x4ade80, 2, 50);
    pointLight.position.set(5, 5, 5);
    scene.add(pointLight);

    // The Zen Sphere (Crystalline Icosahedron)
    const geometry = new THREE.IcosahedronGeometry(1.5, 4);
    const material = new THREE.MeshPhysicalMaterial({
      color: 0x166534,
      metalness: 0.1,
      roughness: 0.2,
      transmission: 0.5,
      thickness: 0.5,
      transparent: true,
      opacity: 0.8,
      wireframe: true
    });
    sphere = new THREE.Mesh(geometry, material);
    scene.add(sphere);

    // Particle Ambiance
    const particlesCount = 1000;
    const posArray = new Float32Array(particlesCount * 3);
    for(let i=0; i < particlesCount * 3; i++) {
      posArray[i] = (Math.random() - 0.5) * 20;
    }
    const particlesGeo = new THREE.BufferGeometry();
    particlesGeo.setAttribute('position', new THREE.BufferAttribute(posArray, 3));
    const particlesMat = new THREE.PointsMaterial({
      size: 0.02,
      color: 0x4ade80,
      transparent: true,
      opacity: 0.5
    });
    clouds = new THREE.Points(particlesGeo, particlesMat);
    scene.add(clouds);

    animate();
  }

  function animate() {
    requestAnimationFrame(animate);
    const time = clock.getElapsedTime();

    if (sphere) {
      sphere.rotation.y += 0.005;
      sphere.rotation.x += 0.002;

      // Pulse logic based on state
      let targetScale = 1;
      let targetOpacity = 0.8;
      
      if (breathingState === 'inhale') {
        targetScale = 1.8 + Math.sin(time * 2) * 0.1;
        targetOpacity = 0.9;
        sphere.material.color.setHex(0x22c55e);
      } else if (breathingState === 'hold') {
        targetScale = 1.8;
        targetOpacity = 1.0;
        sphere.material.color.setHex(0xf59e0b);
      } else if (breathingState === 'exhale') {
        targetScale = 1;
        targetOpacity = 0.6;
        sphere.material.color.setHex(0x166534);
      } else {
        targetScale = 1 + Math.sin(time) * 0.05;
      }

      sphere.scale.lerp(new THREE.Vector3(targetScale, targetScale, targetScale), 0.02);
      sphere.material.opacity = THREE.MathUtils.lerp(sphere.material.opacity, targetOpacity, 0.05);
    }

    if (clouds) {
      clouds.rotation.y += 0.001;
    }

    renderer.render(scene, camera);
  }

  // Handle Resize
  window.addEventListener('resize', () => {
    if (!renderer) return;
    camera.aspect = container.clientWidth / container.clientHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(container.clientWidth, container.clientHeight);
  });

  // TIMER & STATE LOGIC
  let breathingInterval;
  let timerInterval;
  let phaseTimeout1, phaseTimeout2;
  let seconds = 0;
  
  const detail = document.getElementById('breathing-detail');
  const timerDisplay = document.getElementById('zen-timer');
  const startBtn = document.getElementById('start-breath');
  const stopBtn = document.getElementById('stop-breath');

  function updateTimer() {
    seconds++;
    const mins = Math.floor(seconds / 60).toString().padStart(2, '0');
    const secs = (seconds % 60).toString().padStart(2, '0');
    timerDisplay.textContent = `${mins}:${secs}`;
  }

  function startBreathing() {
    if (!renderer) initThree();
    
    seconds = 0;
    timerDisplay.textContent = "00:00";
    startBtn.style.display = 'none';
    stopBtn.style.display = 'inline-block';
    
    timerInterval = setInterval(updateTimer, 1000);
    
    const runCycle = () => {
      const lang = localStorage.getItem('lang') || 'en';
      const t = translations[lang];

      // Inhale (4 seconds)
      breathingState = 'inhale';
      overlayText.textContent = t.nav_inhale || (lang === 'ta' ? 'சுவாசி' : (lang === 'hi' ? 'सांस लें' : 'Inhale'));
      detail.textContent = t.breath_guide;
      
      phaseTimeout1 = setTimeout(() => {
        // Hold (7 seconds)
        breathingState = 'hold';
        overlayText.textContent = t.nav_hold || (lang === 'ta' ? 'நிறுத்து' : (lang === 'hi' ? 'रुकें' : 'Hold'));
        detail.textContent = t.breath_pause;
        
        phaseTimeout2 = setTimeout(() => {
          // Exhale (8 seconds)
          breathingState = 'exhale';
          overlayText.textContent = t.nav_exhale || (lang === 'ta' ? 'வெளியீடு' : (lang === 'hi' ? 'छோड़ें' : 'Exhale'));
          detail.textContent = t.breath_release;
        }, 7000);
      }, 4000);
    };

    runCycle();
    breathingInterval = setInterval(runCycle, 19000); 
  }

  function stopBreathing() {
    const lang = localStorage.getItem('lang') || 'en';
    const t = translations[lang];
    clearInterval(breathingInterval);
    clearInterval(timerInterval);
    clearTimeout(phaseTimeout1);
    clearTimeout(phaseTimeout2);
    breathingState = 'ready';
    overlayText.textContent = t.breath_ready;
    detail.textContent = t.breath_ready_desc || (lang === 'ta' ? 'தயாராக இருங்கள்' : 'Ready?');
    startBtn.style.display = 'inline-block';
    stopBtn.style.display = 'none';
  }

  startBtn.addEventListener('click', startBreathing);
  stopBtn.addEventListener('click', stopBreathing);

  // Initialize Three on load just to show the sphere
  window.addEventListener('DOMContentLoaded', initThree);
</script>
