<div class="container" style="min-height: 70vh; padding: 4rem 0;">
  <div class="dash-header">
    <h2>Welcome Home.</h2>
    <a href="/services" class="btn btn-primary">Book New Service</a>
  </div>

  <div class="dashboard-grid">
    <aside class="sidebar">
      <h3>Quick Links</h3>
      <ul class="sidebar-nav">
        <li><a href="/dashboard" class="active">My Appointments</a></li>
        <li><a href="/diary">Nurture Diary</a></li>
        <li><a href="/zen-zone">Zen Zone</a></li>
        <li><a href="/profile">Profile Settings</a></li>
      </ul>
    </aside>

    <main class="dash-content">
      <h3 style="margin-bottom: 2rem; border-bottom: 1px solid #eee; padding-bottom: 1rem;">Upcoming Appointments</h3>

      <div id="appointments-list">
        <p style="color: var(--text-light);">Loading appointments...</p>
      </div>

      <!-- Interactive Wellness Roadmap Section -->
      <div style="margin-top: 4rem; padding-top: 2rem; border-top: 1px solid rgba(0,0,0,0.05);">
        <h3 style="margin-bottom: 2.5rem; display: flex; align-items: center; gap: 1rem;">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
          My Wellness Journey
        </h3>

        <div class="roadmap-container" style="position: relative; padding-left: 50px;">
          <!-- SVG Path -->
          <svg style="position: absolute; left: 15px; top: 0; width: 4px; height: 100%;" preserveAspectRatio="none">
            <line x1="2" y1="0" x2="2" y2="100%" stroke="rgba(207,157,64,0.15)" stroke-width="2" stroke-dasharray="8,8" />
          </svg>

          <!-- Roadmap Nodes -->
          <div class="roadmap-node active" style="margin-bottom: 3rem; position: relative;">
            <div class="node-circle" style="position: absolute; left: -44px; top: 5px; width: 22px; height: 22px; background: var(--accent); border-radius: 50%; box-shadow: 0 0 15px var(--accent); border: 4px solid var(--white);"></div>
            <h4 style="color: var(--primary);">The Awakening</h4>
            <p style="font-size: 0.9rem; color: var(--text-light);">Account created. Your journey to holistic health has begun.</p>
          </div>

          <div class="roadmap-node" id="node-first-session" style="margin-bottom: 3rem; position: relative; opacity: 0.5;">
            <div class="node-circle" style="position: absolute; left: -44px; top: 5px; width: 22px; height: 22px; background: #ddd; border-radius: 50%; border: 4px solid var(--white);"></div>
            <h4 style="color: var(--text-dark);">First Connection</h4>
            <p style="font-size: 0.9rem; color: var(--text-light);">Complete your first wellness session to unlock this milestone.</p>
          </div>

          <div class="roadmap-node" id="node-diary-master" style="margin-bottom: 3rem; position: relative; opacity: 0.5;">
            <div class="node-circle" style="position: absolute; left: -44px; top: 5px; width: 22px; height: 22px; background: #ddd; border-radius: 50%; border: 4px solid var(--white);"></div>
            <h4 style="color: var(--text-dark);">Mindful Explorer</h4>
            <p style="font-size: 0.9rem; color: var(--text-light);">Log 7 entries in your Nurture Diary to master your mood awareness.</p>
          </div>

          <div class="roadmap-node" style="position: relative; opacity: 0.5;">
            <div class="node-circle" style="position: absolute; left: -44px; top: 5px; width: 22px; height: 22px; background: #ddd; border-radius: 50%; border: 4px solid var(--white);"></div>
            <h4 style="color: var(--text-dark);">The Master Healer</h4>
            <p style="font-size: 0.9rem; color: var(--text-light);">Achieve full harmony across all wellness disciplines.</p>
          </div>
        </div>
      </div>
    </main>
  </div>
</div>

<script>
  async function fetchAppointments() {
    try {
      // Assuming cookie is automatically sent for authorization
      const res = await fetch('/api/appointments/myappointments');
      const data = await res.json();

      const list = document.getElementById('appointments-list');

      if (data.success && data.count > 0) {
        let html = '';
        data.data.forEach(app => {
          html += `
            <div class="appointment-card">
              <div class="appointment-row">
                <div>
                  <h4 style="margin-bottom: 0.5rem; color: var(--primary);">${app.service ? app.service.name : 'Unknown Service'}</h4>
                  <p style="font-size: 0.9rem; color: var(--text-light);">Date: ${new Date(app.date).toDateString()} | Time: ${app.time}</p>
                </div>
                <div style="text-align: right;">
                  <span class="appointment-status">
                    ${app.status}
                  </span><br>
                  ${app.meetLink ? `<a href="${app.meetLink}" target="_blank" class="btn btn-outline" style="padding: 0.4rem 1rem; font-size: 0.8rem;">Join Meet</a>` : ''}
                </div>
              </div>
            </div>
          `;
        });
        list.innerHTML = html;
      } else {
        list.innerHTML = '<p style="color: var(--text-light);">You have no upcoming appointments.</p>';
      }
    } catch (err) {
      console.log(err);
      document.getElementById('appointments-list').innerHTML = '<p style="color: red;">Failed to load appointments.</p>';
    }
  }

  fetchAppointments();
</script>
