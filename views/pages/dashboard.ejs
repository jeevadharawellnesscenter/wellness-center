<div class="container" style="min-height: 70vh; padding: 4rem 0;">
  <div class="dash-header">
    <h2>Welcome Home.</h2>
    <a href="/services" class="btn btn-primary">Book New Service</a>
  </div>

  <div class="dashboard-grid">
    <aside class="sidebar">
      <h3>Quick Links</h3>
      <ul class="sidebar-nav">
        <li><a href="/dashboard" class="active">My Appointments</a></li>
        <li><a href="/diary">Nurture Diary</a></li>
        <li><a href="/zen-zone">Zen Zone</a></li>
        <li><a href="/profile">Profile Settings</a></li>
      </ul>
    </aside>

    <main class="dash-content">
      <h3 style="margin-bottom: 2rem; border-bottom: 1px solid #eee; padding-bottom: 1rem;">Upcoming Appointments</h3>

      <div id="appointments-list">
        <p style="color: var(--text-light);">Loading appointments...</p>
      </div>

      <!-- Wellness Roadmap Section -->
      <div style="margin-top: 4rem; padding-top: 2rem; border-top: 1px solid #eee;">
        <h3 style="margin-bottom: 2rem;">My Wellness Roadmap</h3>
        <div id="roadmap-suggestion" style="background: linear-gradient(135deg, #f0f7f4 0%, #ffffff 100%); padding: 2rem; border-radius: 25px; border: 1px solid rgba(18,53,36,0.05); display: flex; gap: 2rem; align-items: center;">
            <div style="font-size: 3rem;">🌱</div>
            <div>
                <h4 style="color: var(--primary); margin-bottom: 0.5rem;">Suggested Next Step: Hydrotherapy</h4>
                <p style="color: var(--text-light); font-size: 0.95rem; line-height: 1.6;">Based on your recent interest in detoxing, we recommend a 60-min Hydrotherapy session to rejuvenate your circulation.</p>
                <a href="/services/offline" class="btn btn-outline" style="margin-top: 1rem; padding: 0.5rem 1.2rem; font-size: 0.85rem;">View Details</a>
            </div>
        </div>
      </div>
    </main>
  </div>
</div>

<script>
  async function fetchAppointments() {
    try {
      // Assuming cookie is automatically sent for authorization
      const res = await fetch('/api/appointments/myappointments');
      const data = await res.json();

      const list = document.getElementById('appointments-list');

      if (data.success && data.count > 0) {
        let html = '';
        data.data.forEach(app => {
          html += `
            <div class="appointment-card">
              <div class="appointment-row">
                <div>
                  <h4 style="margin-bottom: 0.5rem; color: var(--primary);">${app.service ? app.service.name : 'Unknown Service'}</h4>
                  <p style="font-size: 0.9rem; color: var(--text-light);">Date: ${new Date(app.date).toDateString()} | Time: ${app.time}</p>
                </div>
                <div style="text-align: right;">
                  <span class="appointment-status">
                    ${app.status}
                  </span><br>
                  ${app.meetLink ? `<a href="${app.meetLink}" target="_blank" class="btn btn-outline" style="padding: 0.4rem 1rem; font-size: 0.8rem;">Join Meet</a>` : ''}
                </div>
              </div>
            </div>
          `;
        });
        list.innerHTML = html;
      } else {
        list.innerHTML = '<p style="color: var(--text-light);">You have no upcoming appointments.</p>';
      }
    } catch (err) {
      console.log(err);
      document.getElementById('appointments-list').innerHTML = '<p style="color: red;">Failed to load appointments.</p>';
    }
  }

  fetchAppointments();
</script>
